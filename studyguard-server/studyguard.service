[Unit]
Description=StudyGuard Backend Server
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/studyguard-server
ExecStart=/usr/bin/node /home/ubuntu/studyguard-server/server.js
Restart=always
RestartSec=5
Environment=PORT=3000

[Install]
WantedBy=multi-user.target
