# Nginx 反向代理配置（加到现有 server 块里）
# 因为 80 端口已有其他应用，用路径前缀 /studyguard/ 转发到后端 3000 端口
#
# 在现有 nginx 配置的 server { } 块内加入：

location /studyguard/ {
    proxy_pass http://127.0.0.1:3000/;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
}

# 配置后：
#   版本接口：http://你的服务器IP/studyguard/api/version
#   题库接口：http://你的服务器IP/studyguard/api/questions
#   APK下载：  http://你的服务器IP/studyguard/apk/studyguard-latest.apk
