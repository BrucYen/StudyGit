# 学伴守护 Nginx 配置（域名 wytek.cloud）
#
# 1. 把本文件放到 /etc/nginx/sites-available/studyguard.conf
# 2. 创建软链：sudo ln -s /etc/nginx/sites-available/studyguard.conf /etc/nginx/sites-enabled/
# 3. 申请 SSL 证书（如果还没有）：
#      sudo apt install -y certbot python3-certbot-nginx
#      sudo certbot --nginx -d wytek.cloud
# 4. 测试并重载：sudo nginx -t && sudo systemctl reload nginx

# HTTP 80 → 强制跳转 HTTPS
server {
    listen 80;
    server_name wytek.cloud;
    return 301 https://$host$request_uri;
}

# HTTPS 443 → 反代到后端 3000
server {
    listen 443 ssl;
    server_name wytek.cloud;

    # SSL 证书（certbot 自动签发的路径）
    ssl_certificate     /etc/letsencrypt/live/wytek.cloud/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/wytek.cloud/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 50m;  # APK 上传/下载较大

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
